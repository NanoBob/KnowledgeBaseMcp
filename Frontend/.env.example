# Leave empty to call the API through the Vite dev-server proxy (recommended for local development).
# Set an absolute URL to call the API directly; the server allows the origins listed in
# Frontend:Origins (defaults to http://localhost:5173 and http://localhost:4173).
# VITE_API_BASE=http://localhost:8080

# Where the dev-server proxy forwards /admin and /health.
# AKB_API_URL=http://localhost:8080
